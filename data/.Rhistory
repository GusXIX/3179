pub = read.csv("Yelp_500_PUBS.csv")
location = pub$location
head(location)
# Load required package
library(jsonlite)
# Replace 'address_col' with the actual column name in your data
extract_city <- function(row) {
# Replace single quotes with double quotes and None with null
cleaned <- gsub("'", '"', row)
cleaned <- gsub("\\bNone\\b", 'null', cleaned)
# Try to parse JSON and extract city
parsed <- fromJSON(cleaned)
return(parsed$city)
}
# Apply to each row
pub$city <- sapply(location, extract_city)
summary(pub$city)

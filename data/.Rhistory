df = read.csv("fuel_ass2_2024.csv")
geoProb <- function(y, Phi)
{
prob = (exp(Phi)+1)^(-y-1)*exp(y*Phi)
return(prob)
}
print(geoProb(1,0))
print(geoProb(0,0))
